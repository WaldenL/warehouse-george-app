{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observations",
    "label_transcriptions",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "warehouse_visual_observations_v1"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value",
          "photos",
          "evidence_text",
          "basis"
        ],
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "brand",
              "expression",
              "packaging_designation",
              "category",
              "subcategory",
              "country",
              "region",
              "producer_label_text",
              "distillery_label_text",
              "bottler_label_text",
              "importer_label_text",
              "distilled_and_bottled_by_label_text",
              "distilled_year",
              "barreled_year",
              "bottled_year",
              "vintage_year",
              "release_year",
              "stated_age",
              "barrel_number",
              "batch_number",
              "cask_type",
              "finish",
              "abv_percent",
              "volume",
              "bottled_in_bond",
              "grape_varieties",
              "appellation",
              "other_specifications",
              "warehouse_label_number",
              "producer_bottle_number",
              "tax_stamp_numbers",
              "government_markings",
              "manufacturer_codes",
              "unclassified_numbers",
              "private_selection_name",
              "private_selection_label_text",
              "limited_release_label_claim",
              "other_label_claims",
              "distinctive_features",
              "fill_level_description",
              "seal_status",
              "closure_description",
              "label_condition",
              "glass_condition",
              "packaging_condition"
            ]
          },
          "value": {
            "type": "string"
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "evidence_text": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "enum": [
              "visible_text",
              "visual_observation",
              "calculation"
            ]
          }
        }
      }
    },
    "label_transcriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "photo_number",
          "text"
        ],
        "properties": {
          "photo_number": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
